    # মাঝে মাঝে অন্য ভাষা লাগলে (Japanese, Arabic ইত্যাদি) নিচের কোড ব্লক থেকে দরকারমতো
    # লিস্টে যোগ করুন — কিন্তু প্রতিটা নতুন ভাষা মানেই কমান্ড প্রসেস হতে বেশি সময় লাগবে।
    # ক্রম = priority: প্রথমেরটা আগে try হবে। যেই ভাষাগুলো আসলে ব্যবহার করবেন না, লিস্ট থেকে বাদ দিন —
    # প্রতিটা অতিরিক্ত ভাষা মানেই প্রতিটা voice command-এ বাড়তি delay (নিচের নোট দেখুন)।
}


def load_config():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            merged = {**DEFAULT_CONFIG, **data}
            return merged
        except Exception as e:
            log_and_print(f"Config load error, using defaults: {e}", "error")
    return dict(DEFAULT_CONFIG)


def save_config(config):
    try:
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=2)
    except Exception as e:
        log_and_print(f"Config save error: {e}", "error")


