GITHUB_PERSONAL_ACCESS_TOKEN=
POSTGRES_URL=
JARVIS_FS_ROOT=

# --- Gemini multi-account (see docs/GEMINI_MULTI_ACCOUNT.md) ---
# Each slot is an independent Gemini API key. Leave a slot empty to mark it Missing.
# Never commit real keys; .env is git-ignored.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Optional:
# GEMINI_ACTIVE_SLOT=1      # explicit choice; never changed automatically on failure
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_RETRIES=2      # 0-3, same-key retries for timeouts / 429 / 5xx
# GEMINI_TIMEOUT_S=30       # 5-120
